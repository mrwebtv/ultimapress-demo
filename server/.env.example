DOMAIN=tryultimapress.com

# Long random values: run  openssl rand -hex 24  for each.
POSTGRES_PASSWORD=
# Password for https://tryultimapress.com/leads.csv (any user name).
ADMIN_PASSWORD=

# Cloudflare Turnstile widget "UltimaPress trial".
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Omnisend: Store settings > API keys. Every visitor is added as subscribed, tagged ultimapress-trial.
OMNISEND_API_KEY=

HOSTING_URL=https://www.hostinger.com/mrwebvps
IMAGE=ghcr.io/mrwebtv/ultimapress-demo:latest

# Capacity: demos at once, spare demos kept ready, minutes per demo, minutes alone before it ends.
MAX_DEMOS=12
POOL=2
DEMO_MINUTES=120
IDLE_MINUTES=30
DEMOS_PER_IP_PER_DAY=1
# 1 = sign-up page says all slots are taken and takes no sign-ups.
PAUSED=

# Your own emails, to test without the daily limit (comma separated).
UNLIMITED_EMAILS=
DEMO_MEMORY_MB=768
